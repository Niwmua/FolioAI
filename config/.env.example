# folioai settings.
#
# Copy to config/.env and edit. That file is gitignored, so it is also the right place for
# an API key on a machine you control -- keys are never read from a YAML config (§16).
#
# Precedence: real environment  >  ./.env  >  config/.env  >  built-in defaults.
# Nothing here ever overwrites a variable that is already set in your shell.
#
# To see what is actually in effect, and where each value came from:
#     folioai config           # models, behaviour, provenance
#     folioai config --check   # ...and whether your endpoint really has those models
#     folioai paths            # file locations

# ---------------------------------------------------------------- credentials
FOLIOAI_API_KEY=
FOLIOAI_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------- models
# Seven roles. Only the first two have built-in defaults; the rest inherit the translator
# unless you set them, so naming just these two gives you a system where every call goes to
# a model your endpoint actually has.
#
# Set the others when a cheaper or stronger model suits the job -- a small fast model is
# usually right for the summarizer, and a stronger one for escalation.

FOLIOAI_TRANSLATOR_MODEL=
FOLIOAI_EVALUATOR_MODEL=
# The evaluator should be a *different* model from the translator: two instances of one
# model share their blind spots, which is the main failure mode of LLM-as-judge (§10).

# FOLIOAI_ESCALATION_MODEL=        # attempt 3 of the retry ladder
# FOLIOAI_SUMMARIZER_MODEL=        # the rolling chapter summary
# FOLIOAI_GLOSSARY_MODEL=          # term extraction
# FOLIOAI_BACK_TRANSLATOR_MODEL=   # --eval-mode back-translation / both
# FOLIOAI_VISION_MODEL=            # --vision-fallback page transcription

# ---------------------------------------------------------------- paths
# Everything defaults to a subdirectory of FOLIOAI_HOME, so for most people that one line is
# the whole section. Relative paths resolve against the working directory.

# FOLIOAI_HOME=~/.folioai

# Override individually when the defaults are not where you want them -- a cache on a fast
# disk, logs on a mounted volume, jobs somewhere with room for a few hundred books.
# FOLIOAI_JOBS_DIR=~/.folioai/jobs
# FOLIOAI_LOGS_DIR=~/.folioai/logs
# FOLIOAI_CACHE_DB=~/.folioai/cache.db
# FOLIOAI_STATE_FILE=~/.folioai/state.json
# FOLIOAI_USER_CONFIG=~/.folioai/config.yaml

# Where default.yaml, profiles/ and this file live. Point it at a checkout to edit the
# shipped defaults without reinstalling.
# FOLIOAI_CONFIG_DIR=./config

# Helper binaries and extra fonts. folioai looks in the bin directory for Typst and
# epubcheck, so a downloaded binary works without touching PATH; every font in the fonts
# directory is offered to the PDF renderer, which is how you get Persian, Arabic or CJK
# output without installing anything system-wide.
# FOLIOAI_BIN_DIR=~/.folioai/bin
# FOLIOAI_FONTS_DIR=~/.folioai/fonts

# ---------------------------------------------------------------- export tools
# Point these at the binaries directly if they live somewhere unusual.
# FOLIOAI_TYPST_PATH=/opt/typst/typst
# FOLIOAI_EPUBCHECK=/opt/epubcheck/epubcheck.jar    # run with java -jar
# FOLIOAI_PDF_ENGINE=auto                            # auto | typst | weasyprint

# ---------------------------------------------------------------- behaviour
# The settings people change most, with a short name each.
# FOLIOAI_LOG_LEVEL=INFO
# FOLIOAI_CONCURRENCY=4
# FOLIOAI_BATCH_TOKENS=1200
# Completion budget reserved for a model that thinks before it answers. Reasoning tokens
# count against max_tokens and never appear in the response, so too little here truncates
# every reply -- classically, chapter headings come back translated and nothing else.
# Raise it if the log shows 'reasoning_budget_exhausted'.
# FOLIOAI_TRANSLATION__REASONING_HEADROOM_TOKENS=2000
# FOLIOAI_MIN_SCORE=80
# FOLIOAI_EVAL_MODE=direct          # direct | back-translation | both
# FOLIOAI_EVAL_SAMPLE=1.0
# FOLIOAI_MAX_ATTEMPTS=3
# FOLIOAI_MAX_COST=25.00
# FOLIOAI_TIMEOUT=180
# FOLIOAI_RPM=60
# FOLIOAI_TPM=120000

# Anything else from default.yaml can be set with a double underscore for nesting:
# FOLIOAI_TRANSLATION__MAX_COMPLETION_RATIO=3.0
# FOLIOAI_EVALUATION__COMPLETENESS_FLOOR=70
# FOLIOAI_CLEANING__DEHYPHENATE=true
